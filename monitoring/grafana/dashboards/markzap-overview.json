---
# Grafana Dashboard - MarkZap Production Overview
apiVersion: 1

datasources:
  - name: Prometheus
    type: prometheus
    access: proxy
    url: http://prometheus:9090
    isDefault: true

organizations:
  - name: MarkZap
    enabled: true

folders:
  - title: MarkZap Production
    uid: markzap-prod
    description: Main production monitoring dashboards

dashboards:
  - folder: MarkZap Production
    overwrite: true
    datasource: Prometheus
    options:
      editable: true
      hideControls: false
      tags: ['markzap', 'production']
    annotations:
      list:
        - builtIn: 1
          datasource: Prometheus
          enable: true
          name: 'Annotations & Alerts'
    tpl:
      list: []
    time:
      from: now-6h
      to: now
    timepicker:
      refresh_intervals:
        - 5s
        - 10s
        - 30s
        - 1m
        - 5m
        - 15m
        - 30m
        - 1h
        - 2h
        - 1d
      time_options:
        - 5m
        - 15m
        - 1h
        - 6h
        - 12h
        - 1d
        - 2d
        - 7d
    title: MarkZap Production Overview
    uid: markzap-overview
    version: 1
    panels:
      # Row: System Health
      - gridPos:
          h: 6
          w: 12
          x: 0
          y: 0
        id: 1
        panelVersion: 1
        target:
          expr: up{job="markzap-app"}
          legendFormat: "{{instance}}"
          refId: A
        title: Application Status
        type: stat
        options:
          colorMode: value
          graphMode: area
          orientation: auto
          reduceOptions:
            values: false
            calcs: ["lastNotNull"]
            fields: ""
          textMode: value_and_name

      # CPU Usage
      - gridPos:
          h: 8
          w: 6
          x: 0
          y: 6
        id: 2
        panelVersion: 1
        target:
          expr: 100 - (avg(rate(node_cpu_seconds_total{mode="idle"}[2m])) * 100)
          legendFormat: "{{instance}}"
          refId: B
        title: CPU Usage %
        type: graph
        options:
          legend:
            displayMode: list
            placement: bottom

      # Memory Usage
      - gridPos:
          h: 8
          w: 6
          x: 6
          y: 6
        id: 3
        panelVersion: 1
        target:
          expr: (1 - node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes) * 100
          legendFormat: "{{instance}}"
          refId: C
        title: Memory Usage %
        type: graph
        options:
          legend:
            displayMode: list
            placement: bottom

      # Response Time
      - gridPos:
          h: 8
          w: 6
          x: 12
          y: 6
        id: 4
        panelVersion: 1
        target:
          expr: histogram_quantile(0.95, rate(http_request_duration_seconds_bucket[2m]))
          legendFormat: "{{quantile}}"
          refId: D
        title: Response Time (p95)
        type: graph
        yaxes:
          - format: s
            label: Seconds

      # Request Rate
      - gridPos:
          h: 8
          w: 6
          x: 18
          y: 6
        id: 5
        panelVersion: 1
        target:
          expr: rate(http_requests_total[5m])
          legendFormat: "{{method}} {{route}}"
          refId: E
        title: Request Rate (req/s)
        type: graph

      # Error Rate
      - gridPos:
          h: 8
          w: 12
          x: 0
          y: 14
        id: 6
        panelVersion: 1
        target:
          expr: rate(http_requests_total{status=~"5.."}[5m])
          legendFormat: "{{status}}"
          refId: F
        title: Error Rate (5xx)
        type: graph
        alerts:
          - alertRule:
              evalTime: 5m
              conditions:
                - evaluator:
                    params:
                      - 0.05
                    type: gt
                  operator:
                    type: and
                  query:
                    model:
                      datasource: Prometheus
                      expr: rate(http_requests_total{status=~"5.."}[5m])
                      refId: F
                    format: time_series
                  reducer:
                    type: avg
              for: 5m
              frequency: 10s
              handler: 1
          - state: alerting
            status: alerting

      # Database Connections
      - gridPos:
          h: 8
          w: 12
          x: 12
          y: 22
        id: 7
        panelVersion: 1
        target:
          expr: pg_stat_activity_count
          legendFormat: "{{database}}"
          refId: G
        title: Database Connections
        type: graph
