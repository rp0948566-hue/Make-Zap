# Vercel Ignore - Files NOT to upload to Vercel
# Reduces upload size and speeds up builds

# Development artifacts
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.npm

# Local data
backup/
temp/
tmp/
.devcontainer/

# Infrastructure (not needed for deployment)
terraform/
k8s/
charts/
monitoring/
runbooks/
.docs/

# Documentation (optional - exclude to reduce size)
# Keep README.md for reference but can exclude others
*.md
!README.md
!DEPLOYMENT.md
!SECURITY.md

# Tests (if any)
test/
tests/
__tests__/
*.test.js
*.spec.js

# Git
.git/
.gitignore
.gitattributes
.gitmodules

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db
Desktop.ini

# Docker (not needed on Vercel)
Dockerfile
docker-compose.yml
.dockerignore

# CI/CD (not needed on Vercel)
.github/
.gitlab-ci.yml
.travis.yml
.circleci/

# Kilo CLI
.kilocode/
.kilo/

# Playwright
.playwright-mcp/
.playwright/
test-results/
 playwright-report/

# Other
.env.*
!.env.example
.env.local
.env.development
.env.production
.staging/

# Backup scripts (already in repo but not needed for build)
scripts/backup.sh
scripts/backup.bat
scripts/deploy.sh
scripts/pre-deploy-check.sh
scripts/setup-dev.sh

# Config (not needed at runtime)
config/

# Development folder (old versions)
development/

# Logs
logs/
*.log

# Coverage
coverage/
.nyc_output/
htmlcov/

# Build artifacts (local)
public/  # Vercel generates its own build

# Vercel itself
.vercel/
out/
