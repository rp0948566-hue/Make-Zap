# ============================================
# MARKZAP - HTTPS & SECURITY REDIRECTS
# Netlify _redirects file
# Place in root for automatic deployment
# ============================================

# Force HTTPS (301 Permanent Redirect)
http://*/* https://:splat

# Force HTTPS with WWW preference
https://markzap.online/* https://www.markzap.online/:splat 301!

# Secure headers via Netlify
[[headers]]
  for = "/*"
  [headers.values]
    X-Frame-Options = "DENY"
    X-Content-Type-Options = "nosniff"
    X-XSS-Protection = "1; mode=block"
    Referrer-Policy = "strict-origin-when-cross-origin"
    Permissions-Policy = "geolocation=(), microphone=(), camera=()"
    Strict-Transport-Security = "max-age=31536000; includeSubDomains; preload"

# Cache static assets
[[headers]]
  for = "/assets/*"
  [headers.values]
    Cache-Control = "public, max-age=31536000, immutable"

# HTML files should not be cached aggressively
[[headers]]
  for = "/*.html"
  [headers.values]
    Cache-Control = "public, max-age=3600, must-revalidate"

# SPA fallback (if needed)
# /    /index.html   200
