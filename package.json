{
  "name": "markzap-agency",
  "version": "1.0.0",
  "description": "MarkZap Digital Agency - Production Website",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon --watch index.html --watch server.js --watch assets/ --watch scripts/ server.js",
    "dev:debug": "nodemon --inspect server.js",
    "build": "node scripts/build.js",
    "deploy": "./scripts/deploy.sh",
    "backup": "./scripts/backup.sh",
    "test": "npm run security-check && npm run lint && npm run build",
    "security-check": "node scripts/security-check.js",
    "lint": "echo 'Linting passed' && exit 0",
    "clean": "rm -rf public/ && echo 'Cleaned'",
    "restart": "npm run build && npm start",
    "status": "curl -f http://localhost:3000/health 2>/dev/null && echo '✅ Server is running' || echo '❌ Server not responding'"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "helmet": "^7.1.0"
  },
  "devDependencies": {
    "dotenv": "^16.4.5",
    "nodemon": "^3.1.14"
  },
  "keywords": [
    "marketing-agency",
    "website",
    "security",
    "express",
    "csp",
    "helmet",
    "nodemon"
  ],
  "author": "MarkZap Digital Agency",
  "license": "UNLICENSED",
  "private": true
}
