# Development Environment Configuration
# Copy this file to .env and customize for local development
# DO NOT commit .env to git (it's in .gitignore)

# Environment
NODE_ENV=development
PORT=3000
HOST=localhost

# Database (PostgreSQL)
# For local dev, you can use Docker (recommended) or install locally
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=markzap
DATABASE_USER=markzap
DATABASE_PASSWORD=dev_password_123

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Session secret (change this to a long random string)
SESSION_SECRET=dev-secret-change-this-in-production-$(date +%s)

# CORS - allow all in development
CORS_ORIGIN=*

# Logging
LOG_LEVEL=debug

# Database sync - set to true to auto-create tables (if using ORM)
SYNC_DATABASE=false

# Email (optional - for contact form)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password

# External APIs (optional - add when integrating)
# STRIPE_SECRET_KEY=sk_test_...
# SENDGRID_API_KEY=SG....
# GOOGLE_MAPS_API_KEY=...

# Development tools
ENABLE_METRICS=true
METRICS_PORT=9090
